{
  "name": "weft",
  "version": "0.2.0",
  "description": "A vim-like, AI-native terminal reader for books and documents",
  "type": "module",
  "bin": {
    "weft": "./src/cli.ts"
  },
  "scripts": {
    "read": "bun run src/cli.ts",
    "web": "bun run src/web.ts",
    "dev": "bun run src/web.ts panama.epub",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.2",
    "jszip": "^3.10.1",
    "marked": "^18.0.4",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.9.3"
  }
}
